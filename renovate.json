{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:daily"
  ],
  "labels": ["dependencies", "renovate"],
  "kubernetes": {
    "managerFilePatterns": [
      "/manifests/[^/]+/.+\\.yaml$/"
    ]
  },
  "kustomize": {
    "enabled": true
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values\\.yaml$/",
      "/manifests/victoriametrics/vlagent\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Track Caddy release versions without digest-only updates",
      "matchManagers": ["kubernetes"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["caddy"],
      "matchFileNames": ["manifests/www2-yude-jp/deployment.yaml"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "ghcr.io/yude/groffer",
        "ghcr.io/yude/ytnotifier",
        "ghcr.io/yudejp/gri",
        "ghcr.io/yude/yure-docker",
        "ghcr.io/teamecri/addchan"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [],
      "enabled": false
    },
    {
      "matchPackageNames": [],
      "enabled": false
    },
    {
      "enabled": false,
      "matchPackageNames": [
        "docker.io/kubernetesui/{/,}**",
        "kong{/,}**"
      ]
    },
    {
      "matchPackageNames": [],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "branchConcurrentLimit": 5
}
