{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:LLM_MODEL}",
  "default_agent": "sumire",
  "update": "disable",
  "share": "disabled",
  "snapshots": false,
  "lsp": false,
  "formatter": false,
  "websearch": false,
  "warming": false,
  "plugins": [
    "file:///etc/sumire"
  ],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "sumire": {
      "description": "Misskey conversation bot with a shared history",
      "mode": "primary",
      "model": "{env:LLM_MODEL}",
      "system": "{file:/etc/sumire/persona.md}",
      "steps": 4
    },
    "title": {
      "disabled": true
    },
    "summary": {},
    "compaction": {}
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 1500
    }
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "opencode",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "groq",
      "effect": "allow"
    }
  ],
  "providers": {
    "groq": {
      "models": {
        "openai/gpt-oss-20b": {
          "limit": {
            "context": 7000,
            "input": 6000,
            "output": 1000
          },
          "body": {
            "reasoning_effort": "low"
          }
        }
      }
    }
  }
}
