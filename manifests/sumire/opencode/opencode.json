{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:LLM_MODEL}",
  "default_agent": "sumire",
  "update": "disable",
  "share": "disabled",
  "snapshots": false,
  "lsp": false,
  "formatter": false,
  "websearch": false,
  "warming": false,
  "plugins": [],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "sumire": {
      "description": "Misskey conversation bot with a shared history",
      "mode": "primary",
      "model": "{env:LLM_MODEL}",
      "system": "{file:/etc/sumire/persona.md}",
      "steps": 4
    },
    "title": {
      "model": "{env:LLM_MODEL}"
    },
    "summary": {
      "model": "{env:LLM_MODEL}"
    },
    "compaction": {
      "model": "{env:LLM_MODEL}"
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    }
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "opencode",
      "effect": "allow"
    }
  ]
}
